{
  "name": "frc-scouting",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:push": "pnpm --filter @frc/db db:push",
    "db:test": "pnpm --filter @frc/db test:integration",
    "seed": "pnpm --filter @frc/db seed",
    "smoke": "node scripts/smoke.mjs",
    "wait:deploy": "node scripts/wait-for-deploy.mjs",
    "env:example": "node scripts/gen-env-example.mjs",
    "env:example:check": "node scripts/gen-env-example.mjs --check",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "~9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "~9.14.0",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "~8.13.0",
    "vitest": "^2.1.4"
  }
}
