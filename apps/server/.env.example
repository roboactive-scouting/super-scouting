# apps/server/.env.example
#
# GENERATED — do not edit by hand.
# It is generated from docs/ops/ENVIRONMENT.md by `pnpm env:example`.
# No real value belongs in this file, in this repository, in a commit message,
# or in a chat message. Names and placeholders only (SPEC-FINAL Appendix B).

# Project REST URL
# Where: Supabase → Project Settings → API
SUPABASE_URL=

# Full database access
# Where: Supabase → Project Settings → API
# SECRET — set it in the Vercel dashboard, never here.
SUPABASE_SERVICE_ROLE_KEY=

# HS256 signing secret for session tokens
# Where: Generate: openssl rand -base64 48. A different one per environment.
# SECRET — set it in the Vercel dashboard, never here.
AUTH_JWT_SECRET=

# Session lifetime. Default 30
# Where: Configuration
AUTH_TOKEN_TTL_DAYS=

# Re-issue a token older than this. Default 7
# Where: Configuration
AUTH_TOKEN_REFRESH_AFTER_DAYS=

# The client origin permitted by CORS
# Where: The client's Vercel project URL
ALLOWED_ORIGIN=

# development / production
# Where: Set by the platform
NODE_ENV=
